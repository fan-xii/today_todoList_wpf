<UserControl x:Class="TodoApp.Controls.CalendarPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.Resources>
            <SolidColorBrush x:Key="CalBg" Color="#FAF8F5"/>
            <SolidColorBrush x:Key="CalCard" Color="White"/>
            <SolidColorBrush x:Key="CalInk" Color="#111827"/>
            <SolidColorBrush x:Key="CalInkLight" Color="#6B7FA0"/>
            <SolidColorBrush x:Key="CalAccent" Color="#2D3F5F"/>
            <SolidColorBrush x:Key="CalToday" Color="#4A7E50"/>
            <SolidColorBrush x:Key="CalHover" Color="#F0EDE8"/>
            <SolidColorBrush x:Key="CalGray" Color="#6B6560"/>
        </Grid.Resources>

        <Border Background="{StaticResource CalCard}" CornerRadius="8"
                BorderBrush="#E0DDD8" BorderThickness="1"
                Padding="16" Width="320">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Opacity="0.1" ShadowDepth="4"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Month/Year header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PrevMonthBtn" Grid.Column="0"
                            Content="&#x276E;" FontSize="18" FontWeight="Light"
                            Width="36" Height="36"
                            Foreground="{StaticResource CalInkLight}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="PrevMonth_Click"/>
                    <TextBlock x:Name="MonthYearLabel" Grid.Column="1"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource CalInk}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="NextMonthBtn" Grid.Column="2"
                            Content="&#x276F;" FontSize="18" FontWeight="Light"
                            Width="36" Height="36"
                            Foreground="{StaticResource CalInkLight}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="NextMonth_Click"/>
                </Grid>

                <!-- Weekday headers -->
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="日" FontSize="12" FontWeight="Medium" Foreground="{StaticResource CalGray}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="一" FontSize="12" FontWeight="Medium" Foreground="{StaticResource CalGray}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="二" FontSize="12" FontWeight="Medium" Foreground="{StaticResource CalGray}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="三" FontSize="12" FontWeight="Medium" Foreground="{StaticResource CalGray}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="四" FontSize="12" FontWeight="Medium" Foreground="{StaticResource CalGray}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="五" FontSize="12" FontWeight="Medium" Foreground="{StaticResource CalGray}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="六" FontSize="12" FontWeight="Medium" Foreground="{StaticResource CalGray}" HorizontalAlignment="Center"/>
                </Grid>

                <!-- Separator -->
                <Rectangle Grid.Row="2" Height="1" Fill="#E8E4DE" Margin="0,0,0,6"/>

                <!-- Day grid (6 rows x 7 cols) -->
                <Grid x:Name="DayGrid" Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                </Grid>

                <!-- Today button - bottom right -->
                <Button x:Name="TodayBtn" Grid.Row="4"
                        Content="回到今天" FontSize="11"
                        Foreground="{StaticResource CalAccent}"
                        Background="Transparent" BorderThickness="0"
                        Padding="8,3" Cursor="Hand"
                        HorizontalAlignment="Right"
                        Margin="0,6,0,0"
                        Click="Today_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" CornerRadius="3"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#F0EDE8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
