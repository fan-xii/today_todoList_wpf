<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TodoApp.ViewModels"
        xmlns:conv="clr-namespace:TodoApp.Converters"
        xmlns:ctrl="clr-namespace:TodoApp.Controls"
        Title="今日待办"
        Height="680" Width="520"
        MinHeight="400" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:ProgressWidthConverter x:Key="ProgressWidthConv"/>

        <!-- Color palette -->
        <SolidColorBrush x:Key="PaperLightBrush" Color="#FAF8F5"/>
        <SolidColorBrush x:Key="PaperMidBrush" Color="#F0EDE8"/>
        <SolidColorBrush x:Key="PaperDarkBrush" Color="#D8D3CC"/>
        <SolidColorBrush x:Key="InkDeepBrush" Color="#111827"/>
        <SolidColorBrush x:Key="InkMidBrush" Color="#2D3F5F"/>
        <SolidColorBrush x:Key="InkLightBrush" Color="#6B7FA0"/>
        <SolidColorBrush x:Key="TerracottaBrush" Color="#C4735B"/>
        <SolidColorBrush x:Key="SageBrush" Color="#4A7E50"/>
        <SolidColorBrush x:Key="WarmGrayBrush" Color="#6B6560"/>

        <!-- CHECKBOX -->
        <Style x:Key="InkCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="24" Height="24">
                            <Ellipse x:Name="outerCircle"
                                     Stroke="{StaticResource InkLightBrush}"
                                     StrokeThickness="1.5" Fill="Transparent"
                                     Width="22" Height="22"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="innerFill"
                                     Fill="{StaticResource SageBrush}"
                                     Width="16" Height="16"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Opacity="0"/>
                            <Path x:Name="checkMark"
                                  Data="M7,12 L10.5,15.5 L16.5,8"
                                  Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="22" Height="22" Stretch="Uniform" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="innerFill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="checkMark"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15" BeginTime="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="outerCircle"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.6" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="innerFill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="checkMark"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="outerCircle"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outerCircle" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ADD BUTTON -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource InkDeepBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource InkMidBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DELETE BUTTON -->
        <Style x:Key="DeleteBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource WarmGrayBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="&#xD7;" FontSize="18" FontWeight="Light"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TerracottaBrush}"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TEXTBOX -->
        <Style x:Key="InkTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource InkDeepBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource InkDeepBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                BorderBrush="{StaticResource WarmGrayBrush}"
                                BorderThickness="0,0,0,1.5"
                                Padding="0,0,0,4"
                                Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource InkDeepBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CALENDAR TOGGLE BUTTON -->
        <Style x:Key="CalendarToggleBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent"
                                CornerRadius="6" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0EDE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- EMPTY STATE -->
        <Style x:Key="EmptyStateText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource WarmGrayBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,60,0,0"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PaperLightBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="32,28,32,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Calendar toggle button -->
                    <Button x:Name="CalendarToggle"
                            Grid.Column="0"
                            Style="{StaticResource CalendarToggleBtn}"
                            Click="CalendarToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DateDisplay}"
                                       FontSize="15" FontWeight="Medium"
                                       Foreground="{StaticResource InkMidBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" ▾" FontSize="13"
                                       Foreground="{StaticResource InkLightBrush}"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Calendar popup -->
                    <Popup x:Name="CalendarPopupHost"
                           PlacementTarget="{Binding ElementName=CalendarToggle}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           IsOpen="False">
                        <ctrl:CalendarPopup x:Name="Calendar" DateSelected="Calendar_DateSelected"/>
                    </Popup>

                    <Border Grid.Column="1" HorizontalAlignment="Right"
                            Background="{StaticResource PaperMidBrush}"
                            CornerRadius="12" Padding="14,5"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding WeekdayDisplay}"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource InkLightBrush}"/>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding DateBigDisplay}"
                           FontSize="42" FontWeight="Light"
                           Foreground="{StaticResource InkDeepBrush}"
                           Margin="0,8,0,0"
                           FontFamily="Georgia, 'Times New Roman', serif"/>

                <Rectangle Grid.Row="2" Height="1.5"
                           HorizontalAlignment="Left" Width="80"
                           Margin="0,12,0,0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#111827" Offset="0"/>
                            <GradientStop Color="#6B7FA0" Offset="0.6"/>
                            <GradientStop Color="#FAF8F5" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <!-- INPUT -->
            <Grid Grid.Row="1" Margin="32,20,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding NewTodoText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InkTextBox}"
                         x:Name="TodoInput">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddTodoCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1"
                        Content="记录"
                        Command="{Binding AddTodoCommand}"
                        Style="{StaticResource AddButton}"
                        Margin="12,0,0,5"
                        VerticalAlignment="Bottom"/>
            </Grid>

            <!-- STATS BAR -->
            <Grid Grid.Row="2" Margin="32,16,32,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="12" Foreground="{StaticResource WarmGrayBrush}">
                    <Run Text="共"/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource InkMidBrush}"/>
                    <Run Text="项"/>
                </TextBlock>
                <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <Rectangle Height="3" Fill="{StaticResource PaperDarkBrush}" RadiusX="1.5" RadiusY="1.5"/>
                    <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4A7E50" Offset="0"/>
                                <GradientStop Color="#6FA876" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.Width>
                            <MultiBinding Converter="{StaticResource ProgressWidthConv}">
                                <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth"/>
                                <Binding Path="Progress" Mode="OneWay"/>
                            </MultiBinding>
                        </Rectangle.Width>
                    </Rectangle>
                </Grid>
                <TextBlock Grid.Column="2" FontSize="12" Foreground="{StaticResource SageBrush}"
                           FontWeight="SemiBold" Text="{Binding ProgressPercent}"/>
            </Grid>

            <!-- TODO LIST -->
            <Grid Grid.Row="3" Margin="24,8,24,0">
                <TextBlock Style="{StaticResource EmptyStateText}"
                           Text="今天还没有待办事项&#x0A;写下你的第一项计划吧"
                           Visibility="{Binding EmptyVisibility}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Todos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,2" Padding="8,10,8,10"
                                        Background="Transparent" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsCompleted}"
                                                  Style="{StaticResource InkCheckBox}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,14,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Text}"
                                                   FontSize="15" LineHeight="22"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource InkDeepBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WarmGrayBrush}"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource DeleteBtn}"
                                                Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="4" Margin="32,0,32,20" Padding="0,12,0,0">
                <TextBlock Text="今日待办 · 让每一天都有迹可循"
                           FontSize="11"
                           Foreground="{StaticResource WarmGrayBrush}"
                           HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
